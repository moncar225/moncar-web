# Nom affiché par l'application (non secret).
VITE_APP_NAME=MON CAR

# Base de l'API MON CAR (backend Symfony/API Platform de Richard).
# ⚠️ Le contrat OpenAPI n'est pas encore intégré : aucune requête métier
# n'est émise tant que cette valeur n'est pas fournie et documentée.
VITE_API_BASE_URL=

# Active Mock Service Worker en développement (mocks clairement identifiés,
# uniquement pour l'UI et les tests — jamais des données backend réelles).
VITE_ENABLE_MOCKS=false

# Environnement : dev | recette | prod. Normalement fixé par le mode Vite
# (.env.development, .env.recette, .env.production) — ne pas le surcharger.
# VITE_APP_ENV=dev

# DSN Sentry (supervision des erreurs). Vide = désactivé. En CI il vient du
# secret GitHub SENTRY_DSN_WEB ; en local, le mettre dans .env.local.
VITE_SENTRY_DSN=
